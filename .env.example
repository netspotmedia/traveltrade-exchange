# ============================================================
# TravelTrade Exchange — Environment Configuration
# Copy to .env.local and fill in real values. NEVER commit
# real secrets. All variables below are read by the app.
# ============================================================

# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the publishable key if your project exposes one, otherwise the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Fallback read by the client/server when PUBLISHABLE_KEY is empty:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the cron worker (email retries) and admin ops.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments: Paystack (required for live payments) ----
PAYSTACK_SECRET_KEY=

# ---- Email delivery ----
# Primary provider: Resend.
RESEND_API_KEY=
# Optional SMTP fallback provider.
MAIL_FROM_ADDRESS="TravelTrade Exchange <onboarding@resend.dev>"
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Cron protection ----
# Bearer token that must be sent as `Authorization: Bearer <secret>` to
# /api/cron/emails. Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Optional feature flags ----
# Set to "true" to require MFA (TOTP) for all money/messaging/admin actions.
NEXT_PUBLIC_MFA_ENFORCED=false

# ---- Database-only configuration ----
# The withdrawal encryption key lives in platform_config (table), NOT here.
# After deploying, run:
#   update public.platform_config
#      set value = '<64+ char random hex>'
#    where key = 'wallet_encryption_key';
# Withdrawals are refused while the key is the insecure default.